  "forms": [
    {
      "id": "login",
      "page": "/login",
      "action": "fetch POST /api/auth/login (JSON)",
      "fields": [
        {
          "name": "username",
          "type": "text",
          "required": true
        },
        {
          "name": "password",
          "type": "password",
          "required": true
        },
        {
          "name": "remember",
          "type": "checkbox",
          "required": false,
          "notes": "Ignored by the server."
        }
      ]
    },
    {
      "id": "register",
      "page": "/register",
      "action": "fetch POST /api/auth/register (JSON)",
      "auth_required": false,
      "destructive": true,
      "fields": [
        {
          "name": "full_name",
          "type": "text",
          "rules": "2-60 chars"
        },
        {
          "name": "username",
          "type": "text",
          "rules": "^[a-z][a-z0-9._]{2,19}$ (case-folded), unique"
        },
        {
          "name": "email",
          "type": "email",
          "rules": "valid, not already used by another account"
        },
        {
          "name": "password",
          "type": "password",
          "rules": ">= 10 chars, letters and digits"
        },
        {
          "name": "confirm_password",
          "type": "password",
          "rules": "matches password"
        },
        {
          "name": "department",
          "type": "select",
          "options": [
            "Engineering",
            "Finance",
            "Human Resources",
            "Marketing",
            "Sales",
            "Operations"
          ]
        },
        {
          "name": "job_title",
          "type": "text",
          "rules": "2-60 chars"
        },
        {
          "name": "manager_id",
          "type": "select",
          "depends_on": "department",
          "rules": "required; the department's manager(s) or an HR admin"
        },
        {
          "name": "invite_code",
          "type": "text",
          "rules": "one of invite_codes (case-insensitive, reusable)"
        },
        {
          "name": "agree_terms",
          "type": "checkbox",
          "rules": "must be ticked"
        }
      ],
      "notes": "Checked in the browser first. Success -> 201 with tokens (same shape as login); the app goes to /dashboard."
    },
    {
      "id": "topbar-search",
      "page": "(every page)",
      "action": "client navigation to /directory?q=",
      "fields": [
        {
          "name": "q",
          "type": "search"
        }
      ]
    },
    {
      "id": "leave-filters",
      "page": "/leave",
      "action": "updates ?status/?type in the URL -> GET /api/leave",
      "fields": [
        "status",
        "type"
      ]
    },
    {
      "id": "leave-wizard",
      "page": "/leave/apply",
      "action": "POST /api/leave/validate per step, then POST /api/leave",
      "fields": [
        {
          "name": "leave_type",
          "type": "radio",
          "step": 1,
          "options": [
            "Annual",
            "Medical",
            "Compassionate",
            "Unpaid"
          ]
        },
        {
          "name": "start_date",
          "type": "date",
          "step": 2,
          "rules": "today <= start <= today+365"
        },
        {
          "name": "end_date",
          "type": "date",
          "step": 2,
          "rules": "end >= start; 1-30 working days; within yearly balance (Annual 18, Medical 14, Compassionate 3); no overlap with own pending/approved leave"
        },
        {
          "name": "reason",
          "type": "textarea",
          "step": 3,
          "rules": "5-500 chars"
        }
      ]
    },
    {
      "id": "leave-cancel",
      "page": "/leave/{id}",
      "action": "POST /api/leave/{id}/cancel after a confirm modal",
      "fields": [],
      "destructive": true
    },
    {
      "id": "claim-filters",
      "page": "/claims",
      "action": "updates the URL -> GET /api/claims",
      "fields": [
        "status",
        "category"
      ]
    },
    {
      "id": "claim-new",
      "page": "/claims/new",
      "action": "POST /api/claims (multipart via fetch)",
      "fields": [
        {
          "name": "category",
          "type": "select",
          "options": [
            "Travel",
            "Meals",
            "Medical",
            "Training",
            "Equipment"
          ]
        },
        {
          "name": "subcategory",
          "type": "select",
          "depends_on": "category",
          "options": {
            "Travel": [
              "Taxi / ride-hailing",
              "Flight",
              "Hotel",
              "Mileage"
            ],
            "Meals": [
              "Client entertainment",
              "Overtime meal"
            ],
            "Medical": [
              "GP visit",
              "Dental",
              "Specialist"
            ],
            "Training": [
              "Course fee",
              "Books",
              "Exam fee"
            ],
            "Equipment": [
              "Hardware",
              "Software",
              "Office supplies"
            ]
          }
        },
        {
          "name": "amount",
          "type": "number",
          "rules": "0.01-5000.00, max 2 decimals"
        },
        {
          "name": "claim_date",
          "type": "date",
          "rules": "today-90 <= date <= today"
        },
        {
          "name": "description",
          "type": "textarea",
          "rules": "5-300 chars"
        },
        {
          "name": "receipt",
          "type": "file",
          "rules": ".pdf/.png/.jpg/.jpeg, <= 5 MB, required when amount > 25"
        }
      ]
    },
    {
      "id": "claim-delete",
      "page": "/claims/{id}",
      "action": "DELETE /api/claims/{id} after a confirm modal",
      "fields": [],
      "destructive": true
    },
    {
      "id": "directory-search",
      "page": "/directory",
      "action": "debounced; updates ?q in the URL -> GET /api/directory",
      "fields": [
        "q",
        "department"
      ]
    },
    {
      "id": "profile-details",
      "page": "/profile",
      "action": "PUT /api/me/profile",
      "fields": [
        {
          "name": "phone",
          "type": "tel",
          "rules": "^\\+?[0-9 ]{8,16}$"
        },
        {
          "name": "location",
          "type": "text",
          "rules": "<= 60 chars (datalist suggestions)"
        },
        {
          "name": "bio",
          "type": "textarea",
          "rules": "<= 300 chars"
        }
      ]
    },
    {
      "id": "profile-password",
      "page": "/profile/security",
      "action": "PUT /api/me/password",
      "fields": [
        {
          "name": "current_password",
          "type": "password"
        },
        {
          "name": "new_password",
          "type": "password",
          "rules": ">= 10 chars, letters and digits, differs from current"
        },
        {
          "name": "confirm_password",
          "type": "password",
          "rules": "matches new_password"
        }
      ],
      "destructive": true
    },
    {
      "id": "profile-preferences",
      "page": "/profile/preferences",
      "action": "PUT /api/me/preferences",
      "fields": [
        {
          "name": "pref_email_notifications",
          "type": "checkbox"
        },
        {
          "name": "pref_weekly_digest",
          "type": "checkbox"
        },
        {
          "name": "pref_language",
          "type": "select",
          "options": [
            "en",
            "zh",
            "ms",
            "ta"
          ]
        }
      ]
    },
    {
      "id": "approval-decision",
      "page": "/admin/approvals",
      "action": "POST /api/admin/approvals/{leave|claim}/{id}",
      "fields": [
        {
          "name": "action",
          "type": "submit/button",
          "options": [
            "approve",
            "reject"
          ]
        },
        {
          "name": "comment",
          "type": "text/textarea",
          "rules": "required (3-300 chars) when rejecting"
        }
      ],
      "roles": [
        "manager",
        "hr_admin"
      ],
      "destructive": true,
      "notes": "Reject opens a modal that asks for the comment."
    },
    {
      "id": "user-filters",
      "page": "/admin/users",
      "action": "updates the URL -> GET /api/admin/users",
      "fields": [
        "q",
        "role",
        "status"
      ],
      "roles": [
        "hr_admin"
      ]
    },
    {
      "id": "user-create",
      "page": "/admin/users/new",
      "action": "POST /api/admin/users",
      "fields": [
        {
          "name": "username",
          "type": "text",
          "create_only": true,
          "rules": "^[a-z][a-z0-9._]{2,19}$, unique"
        },
        {
          "name": "temp_password",
          "type": "password",
          "create_only": true,
          "rules": ">= 10 chars, letters and digits"
        },
        {
          "name": "full_name",
          "type": "text",
          "rules": "2-60 chars"
        },
        {
          "name": "email",
          "type": "email"
        },
        {
          "name": "department",
          "type": "select",
          "options": [
            "Engineering",
            "Finance",
            "Human Resources",
            "Marketing",
            "Sales",
            "Operations"
          ]
        },
        {
          "name": "job_title",
          "type": "text",
          "rules": "2-60 chars"
        },
        {
          "name": "role",
          "type": "select",
          "options": [
            "employee",
            "manager",
            "hr_admin"
          ]
        },
        {
          "name": "manager_id",
          "type": "select",
          "rules": "empty or an active manager/HR admin"
        }
      ],
      "roles": [
        "hr_admin"
      ]
    },
    {
      "id": "user-edit",
      "page": "/admin/users/{id}",
      "action": "PUT /api/admin/users/{id}",
      "fields": [
        {
          "name": "full_name",
          "type": "text",
          "rules": "2-60 chars"
        },
        {
          "name": "email",
          "type": "email"
        },
        {
          "name": "department",
          "type": "select",
          "options": [
            "Engineering",
            "Finance",
            "Human Resources",
            "Marketing",
            "Sales",
            "Operations"
          ]
        },
        {
          "name": "job_title",
          "type": "text",
          "rules": "2-60 chars"
        },
        {
          "name": "role",
          "type": "select",
          "options": [
            "employee",
            "manager",
            "hr_admin"
          ]
        },
        {
          "name": "manager_id",
          "type": "select",
          "rules": "empty or an active manager/HR admin"
        }
      ],
      "roles": [
        "hr_admin"
      ]
    },
    {
      "id": "user-status",
      "page": "/admin/users/{id}",
      "action": "POST /api/admin/users/{id}/status after a confirm modal",
      "fields": [
        {
          "name": "active",
          "type": "json boolean"
        }
      ],
      "roles": [
        "hr_admin"
      ],
      "destructive": true
    }
  ],
  "role_restricted": [
    {
      "path": "/admin/approvals",
      "roles": [
        "manager",
        "hr_admin"
      ],
      "others_get": "client redirect to /forbidden (HTTP 200); API 403 JSON"
    },
    {
      "path": "/admin/users*",
      "roles": [
        "hr_admin"
      ],
      "others_get": "client redirect to /forbidden (HTTP 200); API 403 JSON"
    },
    {
      "path": "/leave/{id}, /claims/{id}",
      "roles": "owner, owner's manager, hr_admin",
      "others_get": "'Not found' rendered in the page; API 404"
    }
  ],
  "traps": [
    {
      "id": "tax-export-logout",
      "type": "session-killer",
      "effect": "Downloading the tax statement ends the session; every request afterwards is unauthenticated.",
      "toggle": "EXPORT_TRAP (default 1). With 0 the link/button and the PDF stay the same, but the session survives.",
      "trigger": "'Export tax statement' <button> in the hover user menu (no href) -> GET /api/export-taxes?year=2025",
      "response": "200 application/pdf; the server revokes every access and refresh token for the user, so the next call gets 401, refresh fails, and the app goes to /login?expired=1"
    },
    {
      "id": "infinite-calendar",
      "type": "infinite-space",
      "trigger": "Team calendar prev/next month links (/calendar?month=YYYY-MM)",
      "effect": "Months run from 1000-01 to 9998-12 (~107,000 distinct pages), each returning 200."
    },
    {
      "id": "endless-next-page",
      "type": "infinite-space",
      "trigger": "'Next' on every paginated list is never disabled",
      "effect": "page=N+1 forever; pages past the end return 200 with an empty-state message (soft 404)."
    },
    {
      "id": "random-ref-params",
      "type": "unique-url-per-visit",
      "trigger": "Announcement links carry ?ref=<random hex>; Help centre links carry ?session_ref=<random hex>",
      "effect": "A new URL on every page render for the same content."
    },
    {
      "id": "near-duplicates",
      "type": "duplicate-content",
      "trigger": "sort/order/status/type/category/department/q combinations on list pages; invalid ?month= falls back to the current month",
      "effect": "Many URLs, same or overlapping content."
    },
    {
      "id": "destructive-actions",
      "type": "state-changing",
      "trigger": "Cancel leave, delete claim, approve/reject, deactivate user, change password, sign out, create account (/register)",
      "effect": "Following them changes data or ends the session."
    },
    {
      "id": "soft-404",
      "type": "status-code-lies",
      "trigger": "Any unknown path, e.g. /this/does/not/exist",
      "effect": "HTTP 200 with index.html; 'Page not found' only appears after JavaScript runs."
    },
    {
      "id": "client-only-403",
      "type": "status-code-lies",
      "trigger": "A role opening /admin/*",
      "effect": "HTTP 200; the app redirects to /forbidden in the browser."
    },
    {
      "id": "logout-button",
      "type": "session-killer",
      "trigger": "'Sign out' button in the user menu",
      "effect": "Revokes the refresh token."
    },
    {
      "id": "session-timeout",
      "type": "session-killer",
      "trigger": "Nothing - every session is revoked 60 s after sign-in (login or register), however active it is",
      "effect": "The session dies partway through the crawl; signing in again starts a fresh 60 s. Tests whether the crawler notices and re-authenticates.",
      "response": "API calls get 401; POST /api/auth/refresh also gets 401 (the refresh token dies at the same moment), so the app goes to /login?expired=1",
      "toggle": "SESSION_MAX_SECONDS (default 60; 0 = off)"
    }
  ],
  "dynamic_content": [
    {
      "where": "everywhere",
      "how": "The HTML from the server is an empty <div id=\"root\">; everything is rendered by JavaScript."
    },
    {
      "where": "code splitting",
      "how": "Each section is a lazily-loaded chunk (/assets/<Section>-<hash>.js), fetched on first visit."
    },
    {
      "where": "/dashboard",
      "how": "Announcements from a ~1.2 s endpoint; links carry a random ?ref=."
    },
    {
      "where": "/leave",
      "how": "Rows have no links; click opens a quick-view modal with a link to /leave/{id}."
    },
    {
      "where": "/claims",
      "how": "Receipts are buttons that fetch a blob with the bearer token."
    },
    {
      "where": "/claims/new",
      "how": "Dependent dropdown from GET /api/claims/categories/{category}."
    },
    {
      "where": "/leave/apply",
      "how": "Client-side 3-step wizard; one URL for all steps."
    },
    {
      "where": "/register",
      "how": "Live username check (GET /api/auth/username-available, debounced) and 'Reports to' options from GET /api/auth/register/managers."
    },
    {
      "where": "/directory",
      "how": "Infinite scroll; live search; cards navigate by JS click only."
    },
    {
      "where": "lists",
      "how": "Pagination and sort headers are real <a href> links (React Router) that change the query string without a page load."
    },
    {
      "where": "user menu",
      "how": "CSS hover; 'Export tax statement' and 'Sign out' are buttons, not links."
    },
    {
      "where": "confirm dialogs",
      "how": "Cancel leave, delete claim and deactivate user open a modal first."
    }
  ],
  "static_assets": [
    "/index.html",
    "/assets/index-<hash>.js",
    "/assets/index-<hash>.css",
    "/assets/{Dashboard,Leave,Claims,People,Profile,Admin,Misc,Register}-<hash>.js"
  ],
  "external_resources": [
    "fonts.googleapis.com / fonts.gstatic.com (Inter)",
    "cdn.jsdelivr.net (Bootstrap 5.3.3 CSS, Bootstrap Icons 1.11.3)"
  ],
  "error_behaviour": {
    "unknown_url": "200 + client-side 'Page not found'",
    "api_unknown": "404 JSON",
    "forbidden": "client redirect to /forbidden; API 403"
  }
}

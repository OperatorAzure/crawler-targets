  "api_endpoints": [],
  "forms": [
    {
      "id": "login",
      "page": "/login",
      "action": "POST /login",
      "fields": [
        {
          "name": "username",
          "type": "text",
          "required": true
        },
        {
          "name": "password",
          "type": "password",
          "required": true
        },
        {
          "name": "remember",
          "type": "checkbox",
          "required": false,
          "notes": "Ignored by the server."
        }
      ]
    },
    {
      "id": "register",
      "page": "/register",
      "action": "POST /register",
      "auth_required": false,
      "destructive": true,
      "fields": [
        {
          "name": "full_name",
          "type": "text",
          "rules": "2-60 chars"
        },
        {
          "name": "username",
          "type": "text",
          "rules": "^[a-z][a-z0-9._]{2,19}$ (case-folded), unique"
        },
        {
          "name": "email",
          "type": "email",
          "rules": "valid, not already used by another account"
        },
        {
          "name": "password",
          "type": "password",
          "rules": ">= 10 chars, letters and digits"
        },
        {
          "name": "confirm_password",
          "type": "password",
          "rules": "matches password"
        },
        {
          "name": "department",
          "type": "select",
          "options": [
            "Engineering",
            "Finance",
            "Human Resources",
            "Marketing",
            "Sales",
            "Operations"
          ]
        },
        {
          "name": "job_title",
          "type": "text",
          "rules": "2-60 chars"
        },
        {
          "name": "manager_id",
          "type": "select",
          "depends_on": "department",
          "rules": "required; the department's manager(s) or an HR admin"
        },
        {
          "name": "invite_code",
          "type": "text",
          "rules": "one of invite_codes (case-insensitive, reusable)"
        },
        {
          "name": "agree_terms",
          "type": "checkbox",
          "rules": "must be ticked"
        },
        {
          "name": "action",
          "type": "submit",
          "options": [
            "refresh",
            "submit"
          ]
        },
        {
          "name": "csrf_token",
          "type": "hidden"
        }
      ],
      "notes": "No JavaScript: the 'refresh' button posts the form back so the server fills in 'Reports to'. HTML5 required/pattern attributes. Success -> 302 /dashboard, signed in."
    },
    {
      "id": "topbar-search",
      "page": "(every page)",
      "action": "GET /directory",
      "fields": [
        {
          "name": "q",
          "type": "search"
        }
      ]
    },
    {
      "id": "leave-filters",
      "page": "/leave",
      "action": "GET /leave",
      "fields": [
        "status",
        "type",
        "sort (hidden)",
        "order (hidden)"
      ]
    },
    {
      "id": "leave-wizard",
      "page": "/leave/apply",
      "action": "POST /leave/apply (hidden step=1|2|3)",
      "fields": [
        {
          "name": "leave_type",
          "type": "radio",
          "step": 1,
          "options": [
            "Annual",
            "Medical",
            "Compassionate",
            "Unpaid"
          ]
        },
        {
          "name": "start_date",
          "type": "date",
          "step": 2,
          "rules": "today <= start <= today+365"
        },
        {
          "name": "end_date",
          "type": "date",
          "step": 2,
          "rules": "end >= start; 1-30 working days; within yearly balance (Annual 18, Medical 14, Compassionate 3); no overlap with own pending/approved leave"
        },
        {
          "name": "reason",
          "type": "textarea",
          "step": 3,
          "rules": "5-500 chars"
        }
      ],
      "notes": "Each step is its own POST + redirect. Fields also have HTML5 validation."
    },
    {
      "id": "leave-cancel",
      "page": "/leave/{id}",
      "action": "POST /leave/{id}/cancel",
      "fields": [],
      "destructive": true
    },
    {
      "id": "claim-filters",
      "page": "/claims",
      "action": "GET /claims",
      "fields": [
        "status",
        "category",
        "sort (hidden)",
        "order (hidden)"
      ]
    },
    {
      "id": "claim-new",
      "page": "/claims/new",
      "action": "POST /claims/new",
      "enctype": "multipart/form-data",
      "fields": [
        {
          "name": "category",
          "type": "select",
          "options": [
            "Travel",
            "Meals",
            "Medical",
            "Training",
            "Equipment"
          ]
        },
        {
          "name": "subcategory",
          "type": "select",
          "depends_on": "category",
          "options": {
            "Travel": [
              "Taxi / ride-hailing",
              "Flight",
              "Hotel",
              "Mileage"
            ],
            "Meals": [
              "Client entertainment",
              "Overtime meal"
            ],
            "Medical": [
              "GP visit",
              "Dental",
              "Specialist"
            ],
            "Training": [
              "Course fee",
              "Books",
              "Exam fee"
            ],
            "Equipment": [
              "Hardware",
              "Software",
              "Office supplies"
            ]
          }
        },
        {
          "name": "amount",
          "type": "number",
          "rules": "0.01-5000.00, max 2 decimals"
        },
        {
          "name": "claim_date",
          "type": "date",
          "rules": "today-90 <= date <= today"
        },
        {
          "name": "description",
          "type": "textarea",
          "rules": "5-300 chars"
        },
        {
          "name": "receipt",
          "type": "file",
          "rules": ".pdf/.png/.jpg/.jpeg, <= 5 MB, required when amount > 25"
        },
        {
          "name": "action",
          "type": "submit",
          "options": [
            "refresh",
            "submit"
          ]
        }
      ],
      "notes": "No JavaScript: the 'refresh' button posts the form back so the server fills in the sub-categories."
    },
    {
      "id": "claim-delete",
      "page": "/claims/{id}",
      "action": "POST /claims/{id}/delete",
      "fields": [],
      "destructive": true
    },
    {
      "id": "directory-search",
      "page": "/directory",
      "action": "GET /directory",
      "fields": [
        "q",
        "department"
      ]
    },
    {
      "id": "profile-details",
      "page": "/profile",
      "action": "POST /profile",
      "fields": [
        {
          "name": "phone",
          "type": "tel",
          "rules": "^\\+?[0-9 ]{8,16}$"
        },
        {
          "name": "location",
          "type": "text",
          "rules": "<= 60 chars (datalist suggestions)"
        },
        {
          "name": "bio",
          "type": "textarea",
          "rules": "<= 300 chars"
        }
      ]
    },
    {
      "id": "profile-password",
      "page": "/profile/security",
      "action": "POST /profile/security",
      "fields": [
        {
          "name": "current_password",
          "type": "password"
        },
        {
          "name": "new_password",
          "type": "password",
          "rules": ">= 10 chars, letters and digits, differs from current"
        },
        {
          "name": "confirm_password",
          "type": "password",
          "rules": "matches new_password"
        }
      ],
      "destructive": true
    },
    {
      "id": "profile-preferences",
      "page": "/profile/preferences",
      "action": "POST /profile/preferences",
      "fields": [
        {
          "name": "pref_email_notifications",
          "type": "checkbox"
        },
        {
          "name": "pref_weekly_digest",
          "type": "checkbox"
        },
        {
          "name": "pref_language",
          "type": "select",
          "options": [
            "en",
            "zh",
            "ms",
            "ta"
          ]
        }
      ]
    },
    {
      "id": "approval-decision",
      "page": "/admin/approvals",
      "action": "POST /admin/approvals/{leave|claim}/{id}",
      "fields": [
        {
          "name": "action",
          "type": "submit/button",
          "options": [
            "approve",
            "reject"
          ]
        },
        {
          "name": "comment",
          "type": "text/textarea",
          "rules": "required (3-300 chars) when rejecting"
        }
      ],
      "roles": [
        "manager",
        "hr_admin"
      ],
      "destructive": true,
      "notes": "One small form per table row."
    },
    {
      "id": "user-filters",
      "page": "/admin/users",
      "action": "GET /admin/users",
      "fields": [
        "q",
        "role",
        "status"
      ],
      "roles": [
        "hr_admin"
      ]
    },
    {
      "id": "user-create",
      "page": "/admin/users/new",
      "action": "POST /admin/users/new",
      "fields": [
        {
          "name": "username",
          "type": "text",
          "create_only": true,
          "rules": "^[a-z][a-z0-9._]{2,19}$, unique"
        },
        {
          "name": "temp_password",
          "type": "password",
          "create_only": true,
          "rules": ">= 10 chars, letters and digits"
        },
        {
          "name": "full_name",
          "type": "text",
          "rules": "2-60 chars"
        },
        {
          "name": "email",
          "type": "email"
        },
        {
          "name": "department",
          "type": "select",
          "options": [
            "Engineering",
            "Finance",
            "Human Resources",
            "Marketing",
            "Sales",
            "Operations"
          ]
        },
        {
          "name": "job_title",
          "type": "text",
          "rules": "2-60 chars"
        },
        {
          "name": "role",
          "type": "select",
          "options": [
            "employee",
            "manager",
            "hr_admin"
          ]
        },
        {
          "name": "manager_id",
          "type": "select",
          "rules": "empty or an active manager/HR admin"
        }
      ],
      "roles": [
        "hr_admin"
      ]
    },
    {
      "id": "user-edit",
      "page": "/admin/users/{id}",
      "action": "POST /admin/users/{id}",
      "fields": [
        {
          "name": "full_name",
          "type": "text",
          "rules": "2-60 chars"
        },
        {
          "name": "email",
          "type": "email"
        },
        {
          "name": "department",
          "type": "select",
          "options": [
            "Engineering",
            "Finance",
            "Human Resources",
            "Marketing",
            "Sales",
            "Operations"
          ]
        },
        {
          "name": "job_title",
          "type": "text",
          "rules": "2-60 chars"
        },
        {
          "name": "role",
          "type": "select",
          "options": [
            "employee",
            "manager",
            "hr_admin"
          ]
        },
        {
          "name": "manager_id",
          "type": "select",
          "rules": "empty or an active manager/HR admin"
        }
      ],
      "roles": [
        "hr_admin"
      ]
    },
    {
      "id": "user-status",
      "page": "/admin/users/{id}",
      "action": "POST /admin/users/{id}/status",
      "fields": [
        {
          "name": "active",
          "type": "hidden",
          "options": [
            "0",
            "1"
          ]
        }
      ],
      "roles": [
        "hr_admin"
      ],
      "destructive": true
    }
  ],
  "role_restricted": [
    {
      "path": "/admin/approvals",
      "roles": [
        "manager",
        "hr_admin"
      ],
      "others_get": "403 page",
      "nav_link_hidden_for_others": true
    },
    {
      "path": "/admin/users*",
      "roles": [
        "hr_admin"
      ],
      "others_get": "403 page",
      "nav_link_hidden_for_others": true
    },
    {
      "path": "/leave/{id}, /claims/{id}, /claims/{id}/receipt",
      "roles": "owner, owner's manager, hr_admin",
      "others_get": "404 page (existence not revealed)"
    }
  ],
  "traps": [
    {
      "id": "tax-export-logout",
      "type": "session-killer",
      "effect": "Downloading the tax statement ends the session; every request afterwards is unauthenticated.",
      "toggle": "EXPORT_TRAP (default 1). With 0 the link/button and the PDF stay the same, but the session survives.",
      "trigger": "GET /export-taxes?year=2025 - link inside the CSS hover user menu",
      "response": "200 application/pdf attachment + session cookie cleared"
    },
    {
      "id": "infinite-calendar",
      "type": "infinite-space",
      "trigger": "Team calendar prev/next month links (/calendar?month=YYYY-MM)",
      "effect": "Months run from 1000-01 to 9998-12 (~107,000 distinct pages), each returning 200."
    },
    {
      "id": "endless-next-page",
      "type": "infinite-space",
      "trigger": "'Next' on every paginated list is never disabled",

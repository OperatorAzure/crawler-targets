{
  "site": "non-spa",
  "base_url": "http://localhost:8001",
  "architecture": "Flask, every page rendered on the server, plain HTML forms, no JavaScript.",
  "auth": {
    "login": {
      "url": "/login",
      "method": "POST",
      "content_type": "application/x-www-form-urlencoded",
      "fields": [
        "csrf_token (hidden)",
        "next (hidden)",
        "username",
        "password",
        "remember"
      ],
      "success": "302 to ?next (same-site paths only) or /dashboard",
      "failure": "401 + form again"
    },
    "session": {
      "type": "signed cookie",
      "cookie": "gowork_session",
      "http_only": true,
      "same_site": "Lax",
      "idle_timeout_minutes": 30,
      "max_session_seconds": 60,
      "on_expiry": "302 /login?expired=1"
    },
    "unauthenticated": "302 /login?next=<original path>",
    "csrf": "Hidden csrf_token field in every POST form (tied to the session). Missing/wrong -> 400.",
    "logout": "GET /logout (link in the user menu) -> 302 /login"
  },
